# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables instead. Never commit real values.

# Klaviyo public site key (6 characters, safe in the browser bundle).
# Leave empty to turn onsite tracking off (local dev, preview builds).
VITE_KLAVIYO_PUBLIC_KEY=

# Server only (used by /api/subscribe). Private key needs write access to
# Lists, Profiles and Subscriptions. Never prefix with VITE_.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
# Klaviyo order events (Placed Order, Ordered Product, Fulfilled Order and the
# rest) also use KLAVIYO_PRIVATE_API_KEY, so it needs Events write as well.

# ---- Advertising tags (browser, safe to expose) ----
# Each loads only when set, and never for shoppers who opt out on /privacy
# or whose browser sends Global Privacy Control.
# Meta Pixel ID (Events Manager > Data sources), numbers only.
VITE_META_PIXEL_ID=
# TikTok Pixel ID (Ads Manager > Assets > Events > Web events).
VITE_TIKTOK_PIXEL_ID=
# Google tag IDs, comma separated: G-XXXX (GA4) and/or AW-XXXX (Google Ads).
VITE_GOOGLE_TAG_IDS=
# Optional Google Ads purchase conversion, as AW-XXXX/label.
VITE_GOOGLE_ADS_PURCHASE=

# ---- Accounts and orders (Supabase) ----
# Leave the VITE_ pair empty to keep the original demo sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. The service role key bypasses row level security: never
# prefix it with VITE_ and never paste it anywhere public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (PayPal) ----
# VITE_PAYPAL_CLIENT_ID turns on real checkout (needs the Supabase pair above).
# Use the sandbox app's client id until a full test order has gone through.
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live. Must match the app the ids above came from.
PAYPAL_ENV=sandbox
# From the webhook you add to the PayPal app (see README).
PAYPAL_WEBHOOK_ID=

# ---- Store ----
# The site's public address, used in order links in emails and as the
# canonical address search engines see. Defaults to https://skenvisiontime.com.
SITE_URL=
# Same address for the browser (canonical tags). Leave empty for the default.
VITE_SITE_URL=
# Emails allowed into /admin (comma separated). Each person signs up on the store
# with that email and confirms it first.
ADMIN_EMAILS=
# Optional long random string for scripts that call /api/admin (not needed for /admin).
ADMIN_API_TOKEN=
